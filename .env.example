# Administración (use un secreto largo en producción)
ADMIN_TOKEN=cambie-este-token-administrativo
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3400

# Puerto público compatible con OpenAI
GATEWAY_PORT=3401
GATEWAY_HOST=0.0.0.0
# Actívelo sólo si el puerto del gateway recibe tráfico exclusivamente desde Cloudflare Tunnel.
TRUST_CLOUDFLARE_PROXY=false
PUBLIC_GATEWAY_URL=http://localhost:3401

# Servidor local de Proveedor IA Local
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_API_KEY=

# Log de llama.cpp para mostrar la velocidad de prefill en el dashboard
LLAMA_CPP_LOG_PATH=C:\\ai\\Deepseek Harness\\benzIAServer\\logs\\llama-server.log

# Búsqueda web opcional para benzIA Chat (también configurable desde el dashboard)
BRAVE_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_API_KEY=

# Persistencia de métricas
DATA_DIR=./data
REQUEST_TIMEOUT_MS=300000
METRICS_RETENTION_DAYS=30
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_KEY_PER_MINUTE=120
RATE_LIMIT_INFERENCE_PER_MINUTE=20

# 0 conserva la concurrencia actual. Activar tras medir la capacidad del motor.
MAX_CONCURRENT_INFERENCE=0
INFERENCE_QUEUE_SIZE=16
INFERENCE_QUEUE_WAIT_MS=10000

# Opcionales: modelo pequeño para planificar o búsqueda directa sin inferencia previa.
RESEARCH_PLANNER_MODEL=
RESEARCH_DIRECT_SEARCH=false
